# ~/.zshrc — managed by Ansible/dotfiles repo (oh-my-zsh)
# Local machine-specific overrides go in ~/.zshrc.local

# ── PATH ───────────────────────────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$PATH"

# Brew (if installed)
if [ -d "/home/linuxbrew/.linuxbrew" ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# ── oh-my-zsh ──────────────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"

# ── Editor ────────────────────────────────────────────────────────────────────
export EDITOR=nvim
export GIT_EDITOR=nvim

# ── fzf ──────────────────────────────────────────────────────────────────────
# Must be set before oh-my-zsh loads the fzf plugin
[ -d "/home/linuxbrew/.linuxbrew/opt/fzf" ] && export FZF_BASE="/home/linuxbrew/.linuxbrew/opt/fzf"

# ── Theme ─────────────────────────────────────────────────────────────────────
ZSH_THEME="intheloop"

# ── Plugins ───────────────────────────────────────────────────────────────────
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  fzf
  asdf
)

source $ZSH/oh-my-zsh.sh

# ── History ───────────────────────────────────────────────────────────────────
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE

# ── Aliases ───────────────────────────────────────────────────────────────────
alias v="nvim"
alias vim="nvim"
alias ll="ls -lAh --color=auto"
alias la="ls -A --color=auto"
alias ..="cd .."
alias ...="cd ../.."
alias g="git"
alias gs="git status"
alias gp="git pull"

# fd-find ships as 'fdfind' on Ubuntu — alias to fd
if command -v fdfind &>/dev/null && ! command -v fd &>/dev/null; then
  alias fd="fdfind"
fi

# ── dircolors ─────────────────────────────────────────────────────────────────
[[ -f "$HOME/.dircolors" ]] && eval "$(dircolors "$HOME/.dircolors")"

# ── Blank line between commands ───────────────────────────────────────────────
function echo_blank() { echo; }
preexec_functions+=echo_blank

# ── direnv ────────────────────────────────────────────────────────────────────
if command -v direnv &>/dev/null; then
  eval "$(direnv hook zsh)"
fi

# ── Completion ────────────────────────────────────────────────────────────────
fpath=($HOME/.zsh $fpath)
autoload -Uz compinit && compinit

# ── pet (snippet manager) ─────────────────────────────────────────────────────
if command -v pet &>/dev/null; then
  function pet-select() {
    BUFFER=$(pet search --query "$LBUFFER")
    CURSOR=$#BUFFER
    zle redisplay
  }
  zle -N pet-select
  stty -ixon
  bindkey '^s' pet-select

  function pet-copy() {
    SNIPPET=$(pet search --query "$LBUFFER")
    echo -n "$SNIPPET" | xclip -selection clipboard
  }
  zle -N pet-copy
  bindkey '^p' pet-copy
fi

# ── nvm (if present) ──────────────────────────────────────────────────────────
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# ── fzf (via brew/apt) ────────────────────────────────────────────────────────
[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ] && \
  source /usr/share/doc/fzf/examples/key-bindings.zsh

# ── Local overrides (machine-specific, not managed by repo) ───────────────────
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"